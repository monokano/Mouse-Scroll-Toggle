    },
    "Mouse Scroll Toggle Help" : {
      "comment" : "Help menu item and help window title",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mouse Scroll Toggle ヘルプ"
          }
        }
      }
    },
    "Mouse Scroll Toggle is in the Applications folder, but it was moved there in a way that doesn't meet Apple's requirements. Quit Mouse Scroll Toggle, move it to the Desktop in the Finder, move it back to the Applications folder, and then open it again. Also, make sure to move it by itself, not together with other apps." : {
      "comment" : "Translocation alert: 3rd paragraph (original location is inside the Applications folder)",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mouse Scroll Toggleはアプリケーションフォルダにありますが、Appleの条件を満たさない方法で移動されています。Mouse Scroll Toggleを終了し、Finderでいったんデスクトップへ移動してからアプリケーションフォルダへ戻し、もう一度開いてください。さらに、ほかのアプリと一緒ではなく、1つずつ移動することにも注意してください。"
          }
        }
      }
    },
    "Mouse Scroll Toggle is running from a temporary location because it was opened right after being downloaded." : {
      "comment" : "Translocation alert: 1st paragraph",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードした直後のため、Mouse Scroll Toggleは一時的な場所から起動しています。"
          }
        }
      }
    },
    "Move Mouse Scroll Toggle again in the Finder" : {
      "comment" : "Translocation alert title (app is already in the Applications folder)",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mouse Scroll ToggleをFinderで移動し直してください"
          }
        }
      }
    },
    "Move Mouse Scroll Toggle to the Applications folder" : {
      "comment" : "Translocation alert title",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mouse Scroll Toggleをアプリケーションフォルダへ移動してください"
          }
        }
      }
    },
    "No Running Apps to Add" : {
      "comment" : "Settings > Registration: disabled + menu item when every running app is already registered",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追加できる起動中のアプリはありません"
