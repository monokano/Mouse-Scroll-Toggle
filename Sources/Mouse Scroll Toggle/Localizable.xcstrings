{
  "sourceLanguage" : "en",
  "strings" : {
    "“Menu Bar Only” is unavailable on this Mac because the built-in display has a notch, where the menu bar icon could become hidden." : {
      "comment" : "Settings > General: note shown when the Menu Bar Only option is disabled on a Mac with a notch",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacは内蔵ディスプレイにノッチがあり、メニューバーアイコンがノッチの陰に隠れることがあるため、「メニューバーのみ」は使用できません。"
          }
        }
      }
    },
    "⚠️ Permission to control your Mac required" : {
      "comment" : "Accessibility warning",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Macを制御する許可が必要"
          }
        }
      }
    },
    "Permission to control your Mac required" : {
      "comment" : "State label\nTooltip",
