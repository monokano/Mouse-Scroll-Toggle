      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dockのみ"
          }
        }
      }
    },
    "For security, macOS runs apps obtained from the internet from a copy in a temporary location until you move them in the Finder." : {
      "comment" : "Translocation alert: 2nd paragraph",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSは安全のため、インターネットから入手したアプリをFinderで移動するまでは、元の場所ではなく一時的な場所に置いたコピーから起動します。"
          }
        }
      }
    },
    "Forward" : {
      "comment" : "Help window toolbar: go forward (accessibility name)",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
